rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && request.auth.token.email in ['digitalpetroleum.in@gmail.com', 'neeraj@mazda.in', 'neeraj@mazda-pump.in'];
    }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // यूज़र इसी पंप का है (users/{uid}.pumpId == पंप की ID)
    function inPump(pumpId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myDoc().pumpId == pumpId;
    }

    // पंप का दस्तावेज़
    match /pumps/{pumpId} {
      allow read: if isSuper() || inPump(pumpId);
      allow create, update, delete: if isSuper();

      // रोज़ की एंट्री
      match /entries/{entryId} {
        allow read: if isSuper() || inPump(pumpId);
        allow create: if inPump(pumpId)
          && myDoc().role in ['owner', 'manager', 'salesman']
          && request.resource.data.createdBy == request.auth.uid;
        // बदलना और हटाना सिर्फ मालिक (या super admin) कर सकता है
        allow update, delete: if isSuper() || (inPump(pumpId) && myDoc().role == 'owner');
      }

      // रेट (meta/rates)
      match /meta/{docId} {
        allow read: if isSuper() || inPump(pumpId);
        allow write: if isSuper() || (inPump(pumpId) && myDoc().role in ['owner', 'manager']);
      }
    }

    // यूज़र प्रोफ़ाइल: खुद का पढ़ सकते हैं, बनाना/बदलना सिर्फ super admin
    match /users/{uid} {
      allow read: if isSuper() || request.auth.uid == uid;
      allow write: if isSuper();
    }

    // Login ID का रिकॉर्ड: सिर्फ super admin
    match /logins/{loginId} {
      allow read, write: if isSuper();
    }
  }
}
